# The PDS images HappyView's spaces interop suites last passed against.
#
# .github/workflows/interop.yml reads this. Each line moves only through a pull
# request that workflow opens after the suite for that PDS passed against the
# new image, so the pin change can be reviewed and every commit records what it
# was tested with. Edit by hand only to roll one back.
#
# Pinned by digest because happyproto/pds-test rebuilds its tags nightly.
#
# To run a suite locally against these instead of the newest images:
#
#   docker compose --env-file interop/images.env -f docker-compose.zds.yml up -d --wait
#
# Until the first pin lands for a target, its line tracks `latest`.

ZDS_IMAGE=ghcr.io/happyproto/pds-test/zds@sha256:e8dfbd52eb501cfa8f27ce6f6813a6bb8309f46a5ae16d339890e01bcb376b7b
PDSJS_IMAGE=ghcr.io/happyproto/pds-test/pdsjs@sha256:1725c1f8d2cee4c4f5095c9309f6cf27e11336b74452f0ae12628afae5fe22be
ATPROTO_PDS_IMAGE=ghcr.io/happyproto/pds-test/atproto-pds@sha256:ebbc21edb6b16418f3574f40bb5b3860ece588b5f9f5001f9da8152ff50c0c62
PDS_SPACES_ALPHA_IMAGE=ghcr.io/happyproto/pds-test/pds-spaces-alpha@sha256:1cf9349e9f0e89789784569fed376cd647742ea7c368948625f44779ba03f150
